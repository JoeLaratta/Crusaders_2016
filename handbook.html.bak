0AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Oswald';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"579ed87e-fbb3-43ef-a184-a51d6ac1f7fe\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Oswald';\n  font-style: normal;\n  font-weight: 400;\n  font-display: swap;\n  src: url(\"685b6e90-be5d-4a64-b2da-f42a17513805\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* cyrillic-ext */\n@font-face {\n  font-family: 'Oswald';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"092bd362-1ce1-4951-ba29-637a57c838cf\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* cyrillic */\n@font-face {\n  font-family: 'Oswald';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"5207fe5b-cd11-412d-bb45-cdbf87720e43\") format('woff2');\n  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Oswald';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"aecaf89c-2d19-4c48-91cc-6d88350d919a\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Oswald';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"579ed87e-fbb3-43ef-a184-a51d6ac1f7fe\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Oswald';\n  font-style: normal;\n  font-weight: 500;\n  font-display: swap;\n  src: url(\"685b6e90-be5d-4a64-b2da-f42a17513805\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* cyrillic-ext */\n@font-face {\n  font-family: 'Oswald';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"092bd362-1ce1-4951-ba29-637a57c838cf\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* cyrillic */\n@font-face {\n  font-family: 'Oswald';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"5207fe5b-cd11-412d-bb45-cdbf87720e43\") format('woff2');\n  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Oswald';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"aecaf89c-2d19-4c48-91cc-6d88350d919a\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Oswald';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"579ed87e-fbb3-43ef-a184-a51d6ac1f7fe\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Oswald';\n  font-style: normal;\n  font-weight: 600;\n  font-display: swap;\n  src: url(\"685b6e90-be5d-4a64-b2da-f42a17513805\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n/* cyrillic-ext */\n@font-face {\n  font-family: 'Oswald';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"092bd362-1ce1-4951-ba29-637a57c838cf\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* cyrillic */\n@font-face {\n  font-family: 'Oswald';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"5207fe5b-cd11-412d-bb45-cdbf87720e43\") format('woff2');\n  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;\n}\n/* vietnamese */\n@font-face {\n  font-family: 'Oswald';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"aecaf89c-2d19-4c48-91cc-6d88350d919a\") format('woff2');\n  unicode-range: U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB;\n}\n/* latin-ext */\n@font-face {\n  font-family: 'Oswald';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"579ed87e-fbb3-43ef-a184-a51d6ac1f7fe\") format('woff2');\n  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Oswald';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"685b6e90-be5d-4a64-b2da-f42a17513805\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n\n\n/* ==========================================================================\n   Bear Valley Solutions — Color System\n   Two coordinated palettes:\n   1. BRAND MARK  — red + black. Reserved for the logo and small accents.\n   2. EXECUTIVE   — cream, charcoal, bronze/gold, deep teal, forest green,\n                    warm slate grays. The working palette for all documents,\n                    decks, and interfaces. Premium, restrained, earthy.\n   ========================================================================== */\n\n:root {\n  /* ---- Brand mark (use sparingly: logo, key accent) ---- */\n  --bv-red:            #E31300;  /* primary brand red */\n  --bv-red-deep:       #CC0000;  /* pressed / darker red */\n  --bv-black:          #121821;  /* logo black / near-black charcoal */\n\n  /* ---- Ink & neutrals (warm-cool slate) ---- */\n  --bv-ink:            #1F2A33;  /* darkest text on light */\n  --bv-charcoal:       #121821;  /* dark surfaces */\n  --bv-slate-900:      #2A343D;\n  --bv-slate-700:      #3A3A3A;  /* body text */\n  --bv-slate-600:      #5A6770;  /* muted text, captions */\n  --bv-slate-400:      #8A95A0;  /* secondary / disabled */\n  --bv-slate-200:      #C8D2DA;  /* hairlines on dark, dividers */\n  --bv-slate-100:      #E4E8EB;  /* light borders */\n\n  /* ---- Warm paper / surfaces ---- */\n  --bv-cream:          #F5F1EA;  /* signature warm page background */\n  --bv-cream-deep:     #EDE7DC;  /* slightly deeper cream panel */\n  --bv-white:          #FFFFFF;\n\n  /* ---- Deep teal (primary \"blue\" of the executive palette) ---- */\n  --bv-teal:           #244D61;  /* primary accent */\n  --bv-teal-dark:      #1E4252;  /* hover / deep */\n  --bv-teal-mid:       #2A4A5C;\n  --bv-steel:          #156082;  /* brighter teal (links, document rules) */\n\n  /* ---- Bronze / gold (secondary accent, warmth) ---- */\n  --bv-bronze:         #C38F50;  /* metallic accent, rules, numerals */\n  --bv-bronze-deep:    #A8763B;\n  --bv-sand:           #C8B89A;  /* soft tan panel / divider */\n\n  /* ---- Forest (tertiary, \"go\"/positive, environmental) ---- */\n  --bv-forest:         #3F6459;\n  --bv-forest-deep:    #2E4C43;\n\n  /* ---- Semantic status ---- */\n  --bv-success:        #3F6459;\n  --bv-warning:        #C38F50;\n  --bv-danger:         #CC0000;\n  --bv-info:           #244D61;\n\n  /* ==================================================================\n     SEMANTIC ALIASES — prefer these in components & layouts\n     ================================================================== */\n\n  /* Surfaces */\n  --surface-page:      var(--bv-cream);\n  --surface-card:      var(--bv-white);\n  --surface-panel:     var(--bv-cream-deep);\n  --surface-dark:      var(--bv-charcoal);\n  --surface-dark-alt:  var(--bv-slate-900);\n  --surface-sand:      var(--bv-sand);\n\n  /* Text */\n  --text-heading:      var(--bv-ink);\n  --text-body:         var(--bv-slate-700);\n  --text-muted:        var(--bv-slate-600);\n  --text-faint:        var(--bv-slate-400);\n  --text-on-dark:      var(--bv-cream);\n  --text-on-dark-mut:  var(--bv-slate-200);\n\n  /* Accents */\n  --accent-primary:    var(--bv-teal);\n  --accent-primary-h:  var(--bv-teal-dark);\n  --accent-secondary:  var(--bv-bronze);\n  --accent-tertiary:   var(--bv-forest);\n  --accent-brand:      var(--bv-red);\n\n  /* Lines & borders */\n  --border-subtle:     var(--bv-slate-100);\n  --border-default:    var(--bv-slate-200);\n  --border-strong:     var(--bv-slate-400);\n  --rule-accent:       var(--bv-bronze);\n\n  /* Links */\n  --link:              var(--bv-steel);\n  --link-hover:        var(--bv-teal-dark);\n}\n\n/* ==========================================================================\n   Bear Valley Solutions — Typography\n   Trajan Pro  → brand wordmark, cover titles (ALL CAPS, tracked)\n   Oswald      → headings, kicker labels, table heads (condensed, uppercase)\n   Open Sans   → body, UI, captions (humanist sans, highly legible)\n   ========================================================================== */\n\n:root {\n  /* Families */\n  --font-display: \"Trajan Pro\", \"Cinzel\", \"Times New Roman\", serif;\n  --font-heading: \"Oswald\", \"Arial Narrow\", sans-serif;\n  --font-body:    \"Open Sans\", -apple-system, \"Segoe UI\", sans-serif;\n\n  /* Weights */\n  --fw-light:   300; /* @kind font */\n  --fw-regular: 400; /* @kind font */\n  --fw-medium:  500; /* @kind font */\n  --fw-semibold:600; /* @kind font */\n  --fw-bold:    700; /* @kind font */\n\n  /* Type scale (fluid-ready base values) */\n  --fs-display:   56px;  /* cover / hero title (Trajan or Oswald) */\n  --fs-h1:        38px;\n  --fs-h2:        28px;\n  --fs-h3:        21px;\n  --fs-h4:        17px;\n  --fs-kicker:    13px;  /* Oswald uppercase eyebrow label */\n  --fs-body-lg:   18px;\n  --fs-body:      15px;\n  --fs-small:     13px;\n  --fs-caption:   11px;\n\n  /* Line heights */\n  --lh-tight:   1.1; /* @kind other */\n  --lh-heading: 1.2; /* @kind other */\n  --lh-snug:    1.4; /* @kind other */\n  --lh-body:    1.6; /* @kind other */\n\n  /* Letter spacing */\n  --ls-wordmark: 0.08em; /* @kind other */\n  --ls-kicker:   0.18em; /* @kind other */\n  --ls-heading:  0.01em; /* @kind other */\n  --ls-caps:     0.06em; /* @kind other */\n}\n\n/* --------------------------------------------------------------------------\n   Optional utility classes (components use tokens directly; these help decks\n   and documents stay consistent)\n   -------------------------------------------------------------------------- */\n\n.bv-wordmark {\n  font-family: var(--font-display);\n  font-weight: var(--fw-bold);\n  letter-spacing: var(--ls-wordmark);\n  text-transform: uppercase;\n  color: var(--bv-red);\n}\n\n.bv-kicker {\n  font-family: var(--font-heading);\n  font-weight: var(--fw-medium);\n  font-size: var(--fs-kicker);\n  letter-spacing: var(--ls-kicker);\n  text-transform: uppercase;\n  color: var(--accent-secondary);\n}\n\n.bv-h1 { font-family: var(--font-heading); font-weight: var(--fw-semibold); font-size: var(--fs-h1); line-height: var(--lh-heading); color: var(--text-heading); }\n.bv-h2 { font-family: var(--font-heading); font-weight: var(--fw-semibold); font-size: var(--fs-h2); line-height: var(--lh-heading); color: var(--text-heading); }\n.bv-h3 { font-family: var(--font-heading); font-weight: var(--fw-medium);   font-size: var(--fs-h3); line-height: var(--lh-snug);    color: var(--text-heading); }\n\n.bv-body { font-family: var(--font-body); font-weight: var(--fw-regular); font-size: var(--fs-body); line-height: var(--lh-body); color: var(--text-body); }\n\n/* ==========================================================================\n   Bear Valley Solutions — Spacing & Layout\n   4px base grid. Generous white space is a brand signature.\n   ========================================================================== */\n\n:root {\n  --sp-0:   0; /* @kind spacing */\n  --sp-1:   4px;\n  --sp-2:   8px;\n  --sp-3:   12px;\n  --sp-4:   16px;\n  --sp-5:   20px;\n  --sp-6:   24px;\n  --sp-8:   32px;\n  --sp-10:  40px;\n  --sp-12:  48px;\n  --sp-16:  64px;\n  --sp-20:  80px;\n  --sp-24:  96px;\n  --sp-32:  128px;\n\n  /* Document layout */\n  --page-margin:      0.9in;   /* letter document margin */\n  --content-max:      1120px;  /* interface content width */\n  --measure:          68ch;    /* optimal reading line length */\n\n  /* Radii — restrained. Documents/print use square; UI uses subtle rounding */\n  --radius-none: 0;\n  --radius-xs:   2px;\n  --radius-sm:   4px;\n  --radius-md:   6px;\n  --radius-lg:   10px;\n  --radius-pill: 999px;\n}\n\n/* ==========================================================================\n   Bear Valley Solutions — Elevation, Borders & Motion\n   Restrained shadows. Premium look comes from crisp hairlines and a single\n   soft ambient shadow — never heavy drop shadows or glows.\n   ========================================================================== */\n\n:root {\n  /* Shadows — subtle, cool-neutral */\n  --shadow-none: none;\n  --shadow-xs:  0 1px 2px rgba(18, 24, 33, 0.06);\n  --shadow-sm:  0 1px 3px rgba(18, 24, 33, 0.08), 0 1px 2px rgba(18, 24, 33, 0.04);\n  --shadow-md:  0 4px 14px rgba(18, 24, 33, 0.08);\n  --shadow-lg:  0 12px 32px rgba(18, 24, 33, 0.10);\n  --shadow-card: 0 1px 0 var(--bv-slate-100), 0 8px 24px rgba(18, 24, 33, 0.06);\n\n  /* Focus ring */\n  --focus-ring: 0 0 0 3px rgba(36, 77, 97, 0.28);\n\n  /* Standard borders */\n  --border-hair: 1px solid var(--border-default);\n  --border-card: 1px solid var(--border-subtle);\n\n  /* Accent bar — the recurring \"bronze rule\" motif */\n  --accent-bar-w: 3px;\n\n  /* Motion — quiet and executive. Fades and short ease, no bounce. */\n  --ease-standard: cubic-bezier(0.22, 0.61, 0.36, 1); /* @kind other */\n  --ease-out:      cubic-bezier(0.16, 1, 0.3, 1); /* @kind other */\n  --dur-fast:      120ms; /* @kind other */\n  --dur-base:      200ms; /* @kind other */\n  --dur-slow:      340ms; /* @kind other */\n}\n\n<\u002Fstyle>\n<script src=\"63a83728-a315-4343-815d-d4a0d47a2230\"><\u002Fscript>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<style>/* cyrillic-ext */\n@font-face {\n  font-family: 'Open Sans';\n  font-style: italic;\n  font-weight: 400;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"7f953676-d924-4c2d-99b4-ee07a53ced71\") format('woff2');\n  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;\n}\n/* cyrillic */\n@font-face {\n  font-family: 'Open Sans';\n  font-style: italic;\n  font-weight: 400;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"d0fc5d71-6d1d-4b41-9dcc-9c79c9ff92ec\") format('woff2');\n  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;\n}\n/* greek-ext */\n@font-face {\n  font-family: 'Open Sans';\n  font-style: italic;\n  font-weight: 400;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"17d81d90-1e81-4147-8ee0-e900abc9fb5e\") format('woff2');\n  unicode-range: U+1F00-1FFF;\n}\n/* greek */\n@font-face {\n  font-family: 'Open Sans';\n  font-style: italic;\n  font-weight: 400;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"76cb64ac-5335-4647-bea6-a163ce0cd8d0\") format('woff2');\n  unicode-range: U+0370-0377, U+037A-037F, U+0384-038A, U+038C, U+038E-03A1, U+03A3-03FF;\n}\n/* hebrew */\n@font-face {\n  font-family: 'Open Sans';\n  font-style: italic;\n  font-weight: 400;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"fca8a71b-632f-43a2-a865-6c79c1079357\") format('woff2');\n  unicode-range: U+0307-0308, U+0590-05FF, U+200C-2010, U+20AA, U+25CC, U+FB1D-FB4F;\n}\n/* math */\n@font-face {\n  font-family: 'Open Sans';\n  font-style: italic;\n  font-weight: 400;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"5da4d8e1-a1a3-4506-99da-933004690cc8\") format('woff2');\n  unicode-range: U+0302-0303, U+0305, U+0307-0308, U+0310, U+0312, U+0315, U+031A, U+0326-0327, U+032C, U+032F-0330, U+0332-0333, U+0338, U+033A, U+0346, U+034D, U+0391-03A1, U+03A3-03A9, U+03B1-03C9, U+03D1, U+03D5-03D6, U+03F0-03F1, U+03F4-03F5, U+2016-2017, U+2034-2038, U+203C, U+2040, U+2043, U+2047, U+2050, U+2057, U+205F, U+2070-2071, U+2074-208E, U+2090-209C, U+20D0-20DC, U+20E1, U+20E5-20EF, U+2100-2112, U+2114-2115, U+2117-2121, U+2123-214F, U+2190, U+2192, U+2194-21AE, U+21B0-21E5, U+21F1-21F2, U+21F4-2211, U+2213-2214, U+2216-22FF, U+2308-230B, U+2310, U+2319, U+231C-2321, U+2336-237A, U+237C, U+2395, U+239B-23B7, U+23D0, U+23DC-23E1, U+2474-2475, U+25AF, U+25B3, U+25B7, U+25BD, U+25C1, U+25CA, U+25CC, U+25FB, U+266D-266F, U+27C0-27FF, U+2900-2AFF, U+2B0E-2B11, U+2B30-2B4C, U+2BFE, U+3030, U+FF5B, U+FF5D, U+1D400-1D7FF, U+1EE00-1EEFF;\n}\n/* symbols */\n@font-face {\n  font-family: 'Open Sans';\n  font-style: italic;\n  font-weight: 400;\n  font-stretch: 100%;\n  font-display: swap;\n  src: url(\"b4cf5f10-bd6f-41b7-bf3b-cbc3503260f1\") format('woff2');\n  unicode-range: U+0001-000C, U+000