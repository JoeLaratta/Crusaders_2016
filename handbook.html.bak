, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;\n}\n/* latin */\n@font-face {\n  font-family: 'Oswald';\n  font-style: normal;\n  font-weight: 700;\n  font-display: swap;\n  src: url(\"79a164f9-447d-439f-a476-e43b880dff67\") format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n<\u002Fstyle>\n<style>\n  html { scroll-behavior: smooth; scroll-padding-top: 84px; }\n  body { margin: 0; background: #0B0B0D; }\n  a { color: #E0A526; text-decoration: none; }\n  a:hover { color: #F2C25B; text-decoration: underline; }\n  input[type=\"text\"], textarea { font-family: 'Open Sans', sans-serif; }\n  input::placeholder, textarea::placeholder { color: #B7AFA2; }\n  @media print { .noprint { display: none !important; } }\n<\u002Fstyle>\n<\u002Fhelmet>\n\n<div style=\"background:#0B0B0D;color:#F5F1EA;font-family:'Open Sans',sans-serif;min-height:100vh\">\n\n  <div class=\"noprint\" style=\"position:sticky;top:0;z-index:50;background:rgba(11,11,13,0.96);border-bottom:1px solid #2A2620\">\n    <div style=\"max-width:1180px;margin:0 auto;padding:14px 28px;display:flex;align-items:center;gap:28px;flex-wrap:wrap\">\n      <a href=\"#top\" style=\"display:flex;align-items:center;gap:12px;flex-shrink:0\">\n        <img src=\"13793e81-cb1a-4c2a-af1b-2dc813e4c1f6\" alt=\"Crusaders\" style=\"width:38px;height:38px;object-fit:contain;display:block\">\n        <span style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:15px;letter-spacing:0.14em;text-transform:uppercase;color:#F5F1EA\">Crusaders<\u002Fspan>\n      <\u002Fa>\n      <nav style=\"display:flex;gap:22px;flex-wrap:wrap;font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:0.1em;text-transform:uppercase\">\n        <a href=\"#overview\" style=\"color:#B7AFA2\">Overview<\u002Fa>\n        <a href=\"#plan\" style=\"color:#B7AFA2\">Season plan<\u002Fa>\n        <a href=\"#standards\" style=\"color:#B7AFA2\">Standards<\u002Fa>\n        <a href=\"#drills\" style=\"color:#B7AFA2\">Drills<\u002Fa>\n        <a href=\"#form\" style=\"color:#B7AFA2\">Player form<\u002Fa>\n        <a href=\"#contacts\" style=\"color:#B7AFA2\">Contacts<\u002Fa>\n        <a href=\"#final\" style=\"color:#B7AFA2\">Final word<\u002Fa>\n      <\u002Fnav>\n    <\u002Fdiv>\n  <\u002Fdiv>\n\n  <section id=\"top\" data-screen-label=\"01 Cover\" style=\"position:relative;padding:88px 28px 64px;background:radial-gradient(120% 90% at 50% 0%, #1A1614 0%, #0B0B0D 62%);border-bottom:3px solid #B3161C\">\n    <div style=\"max-width:900px;margin:0 auto;text-align:center\">\n      <img src=\"13793e81-cb1a-4c2a-af1b-2dc813e4c1f6\" alt=\"Crusaders Hockey Club\" style=\"width:184px;height:184px;object-fit:contain;display:block;margin:0 auto 26px\">\n      <div style=\"font-family:'Oswald',sans-serif;font-size:20px;letter-spacing:0.42em;text-transform:uppercase;color:#E0A526;margin-bottom:8px\">The<\u002Fdiv>\n      <h1 style=\"font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(52px,10vw,116px);line-height:0.9;letter-spacing:0.01em;text-transform:uppercase;margin:0;color:#F5F1EA\">Crusaders<\u002Fh1>\n      <div style=\"font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(42px,8vw,88px);line-height:1;text-transform:uppercase;color:#E0A526;font-style:italic;margin:2px 0 30px\">Way<\u002Fdiv>\n      <div style=\"display:inline-block;background:#B3161C;padding:14px 34px\">\n        <div style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:clamp(20px,3vw,30px);letter-spacing:0.05em;text-transform:uppercase;color:#fff\">2016 Program Manual<\u002Fdiv>\n        <div style=\"font-family:'Oswald',sans-serif;font-size:clamp(14px,2vw,19px);letter-spacing:0.22em;text-transform:uppercase;color:#F2C25B;margin-top:4px\">2026 – 2027 HSL Season<\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"display:flex;justify-content:center;gap:0;flex-wrap:wrap;margin-top:44px;border-top:1px solid #2A2620;padding-top:26px\">\n        <div style=\"padding:6px 22px;border-right:1px solid #2A2620;font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:0.1em;text-transform:uppercase;color:#F5F1EA\"><div style=\"display:flex;flex-direction:column;align-items:center;gap:8px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#E0A526\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:22px;height:22px;flex-shrink:0;display:block\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"><\u002Fpath><\u002Fsvg><span>One purpose.<\u002Fspan><\u002Fdiv><\u002Fdiv>\n        <div style=\"padding:6px 22px;border-right:1px solid #2A2620;font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:0.1em;text-transform:uppercase;color:#F5F1EA\"><div style=\"display:flex;flex-direction:column;align-items:center;gap:8px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#E0A526\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:22px;height:22px;flex-shrink:0;display:block\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26\"><\u002Fpolygon><\u002Fsvg><span>Crusader forever.<\u002Fspan><\u002Fdiv><\u002Fdiv>\n        <div style=\"padding:6px 22px;border-right:1px solid #2A2620;font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:0.1em;text-transform:uppercase;color:#F5F1EA\"><div style=\"display:flex;flex-direction:column;align-items:center;gap:8px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#E0A526\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:22px;height:22px;flex-shrink:0;display:block\"><path d=\"M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z\"><\u002Fpath><\u002Fsvg><span>Love the game.<\u002Fspan><\u002Fdiv><\u002Fdiv>\n        <div style=\"padding:6px 22px;border-right:1px solid #2A2620;font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:0.1em;text-transform:uppercase;color:#F5F1EA\"><div style=\"display:flex;flex-direction:column;align-items:center;gap:8px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#E0A526\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:22px;height:22px;flex-shrink:0;display:block\"><path d=\"m6.5 6.5 11 11\"><\u002Fpath><path d=\"m21 21-1-1\"><\u002Fpath><path d=\"m3 3 1 1\"><\u002Fpath><path d=\"m18 22 4-4\"><\u002Fpath><path d=\"m2 6 4-4\"><\u002Fpath><path d=\"m3 10 7-7\"><\u002Fpath><path d=\"m14 21 7-7\"><\u002Fpath><\u002Fsvg><span>Work hard.<\u002Fspan><\u002Fdiv><\u002Fdiv>\n        <div style=\"padding:6px 22px;font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:0.1em;text-transform:uppercase;color:#F5F1EA\"><div style=\"display:flex;flex-direction:column;align-items:center;gap:8px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#E0A526\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:22px;height:22px;flex-shrink:0;display:block\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"><\u002Fpath><circle cx=\"9\" cy=\"7\" r=\"4\"><\u002Fcircle><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"><\u002Fpath><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"><\u002Fpath><\u002Fsvg><span>Compete together.<\u002Fspan><\u002Fdiv><\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <section id=\"overview\" data-screen-label=\"02 Team overview\" style=\"padding:76px 28px;background:#F5F1EA;color:#121821\">\n    <div style=\"max-width:1000px;margin:0 auto\">\n      <div style=\"font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:0.26em;text-transform:uppercase;color:#B3161C;margin-bottom:10px\">2016 Crusaders — 2026/27 season<\u002Fdiv>\n      <h2 style=\"font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(34px,5vw,54px);line-height:1;text-transform:uppercase;margin:0 0 6px\">Team overview<\u002Fh2>\n      <div style=\"width:72px;height:3px;background:#E0A526;margin-bottom:30px\"><\u002Fdiv>\n      <p style=\"font-size:18px;line-height:1.7;max-width:68ch;margin:0 0 14px;text-wrap:pretty\">Last season, we learned how to become a Team. This season, we will learn how to play as one. While our commitment to being great teammates remains unchanged, our expectations on the ice will continue to grow.<\u002Fp>\n      <p style=\"font-size:18px;line-height:1.7;max-width:68ch;margin:0 0 48px;text-wrap:pretty\">We will focus on developing smarter hockey players through improved game sense, stronger individual skills, and a deeper understanding of team tactics. Our objective is to play fast, think faster, and trust one another to make the right play at the right time.<\u002Fp>\n\n      <div style=\"font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:0.26em;text-transform:uppercase;color:#7A7266;margin-bottom:18px\">Season goals<\u002Fdiv>\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(380px,1fr));gap:20px\">\n        <div style=\"background:#fff;border-top:3px solid #B3161C;padding:26px 24px;box-shadow:0 1px 3px rgba(18,24,33,0.08)\">\n          <div style=\"display:flex;align-items:flex-start;gap:12px;margin:0 0 12px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#B3161C\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:26px;height:26px;flex-shrink:0;display:block\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"><\u002Fpath><circle cx=\"9\" cy=\"7\" r=\"4\"><\u002Fcircle><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"><\u002Fpath><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"><\u002Fpath><\u002Fsvg><h3 style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:23px;line-height:1.1;text-transform:uppercase;color:#B3161C;margin:0\">Team work<\u002Fh3><\u002Fdiv>\n          <p style=\"font-size:15px;line-height:1.65;margin:0;color:#3A3630;text-wrap:pretty\">Great teams don't happen by accident. Every player is expected to establish daily habits that support the Team: arrive early, be mentally and physically prepared, work with purpose, and contribute positively to the group. We don't wait to be motivated — we create energy through our preparation and work ethic.<\u002Fp>\n        <\u002Fdiv>\n        <div style=\"background:#fff;border-top:3px solid #B3161C;padding:26px 24px;box-shadow:0 1px 3px rgba(18,24,33,0.08)\">\n          <div style=\"display:flex;align-items:flex-start;gap:12px;margin:0 0 12px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#B3161C\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:26px;height:26px;flex-shrink:0;display:block\"><path d=\"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5\"><\u002Fpath><path d=\"M9 18h6\"><\u002Fpath><path d=\"M10 22h4\"><\u002Fpath><\u002Fsvg><h3 style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:23px;line-height:1.1;text-transform:uppercase;color:#B3161C;margin:0\">Hockey sense &amp; game awareness<\u002Fh3><\u002Fdiv>\n          <p style=\"font-size:15px;line-height:1.65;margin:0;color:#3A3630;text-wrap:pretty\">Teach players to think the game one step ahead. Through improved awareness, anticipation, communication, and tactical understanding, players will learn to make quicker, smarter decisions and consistently put themselves and their teammates in better positions to succeed.<\u002Fp>\n        <\u002Fdiv>\n        <div style=\"background:#fff;border-top:3px solid #B3161C;padding:26px 24px;box-shadow:0 1px 3px rgba(18,24,33,0.08)\">\n          <div style=\"display:flex;align-items:flex-start;gap:12px;margin:0 0 12px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#B3161C\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:26px;height:26px;flex-shrink:0;display:block\"><path d=\"M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.07-2.14-.22-4.05 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.15.43-2.29 1-3a2.5 2.5 0 0 0 2.5 2.5z\"><\u002Fpath><\u002Fsvg><h3 style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:23px;line-height:1.1;text-transform:uppercase;color:#B3161C;margin:0\">Competitive mindset<\u002Fh3><\u002Fdiv>\n          <p style=\"font-size:15px;line-height:1.65;margin:0;color:#3A3630;text-wrap:pretty\">Create a culture where players compete every day — against themselves, alongside their teammates, and against every opponent. We will celebrate hard work, embrace challenges, and build confidence through preparation, resilience, and relentless effort.<\u002Fp>\n        <\u002Fdiv>\n        <div style=\"background:#fff;border-top:3px solid #B3161C;padding:26px 24px;box-shadow:0 1px 3px rgba(18,24,33,0.08)\">\n          <div style=\"display:flex;align-items:flex-start;gap:12px;margin:0 0 12px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#B3161C\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:26px;height:26px;flex-shrink:0;display:block\"><path d=\"M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z\"><\u002Fpath><path d=\"M3.22 13H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27\"><\u002Fpath><\u002Fsvg><h3 style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:23px;line-height:1.1;text-transform:uppercase;color:#B3161C;margin:0\">Mental strength &amp; emotional maturity<\u002Fh3><\u002Fdiv>\n          <p style=\"font-size:15px;line-height:1.65;margin:0;color:#3A3630;text-wrap:pretty\">Build players who compete with confidence, recover quickly from setbacks, and remain composed in challenging situations. Through goal-setting, accountability, and self-reflection, players will develop the mindset to lead themselves and support their teammates.<\u002Fp>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <section id=\"plan\" data-screen-label=\"03 Season development plan\" style=\"padding:76px 28px;background:#0B0B0D;border-top:3px solid #E0A526\">\n    <div style=\"max-width:1180px;margin:0 auto\">\n      <div style=\"font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:0.26em;text-transform:uppercase;color:#E0A526;margin-bottom:10px\"><div style=\"display:flex;align-items:center;gap:12px\"><img src=\"13793e81-cb1a-4c2a-af1b-2dc813e4c1f6\" alt=\"\" style=\"width:34px;height:34px;object-fit:contain;display:block\"><span style=\"color:#E0A526\">Our path. Our process. Our purpose.<\u002Fspan><\u002Fdiv><\u002Fdiv>\n      <h2 style=\"font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(34px,5vw,54px);line-height:1;text-transform:uppercase;margin:0 0 34px;color:#F5F1EA\">Season development plan<\u002Fh2>\n\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:18px\">\n        <div style=\"background:#151312;border:1px solid #2A2620\">\n          <div style=\"background:#8E1218;padding:16px 20px\">\n            <div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:10px;font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:0.16em;text-transform:uppercase;color:#F2C25B;margin-bottom:6px\"><span>Phase 1<\u002Fspan><span>Aug–Sept<\u002Fspan><\u002Fdiv>\n            <div style=\"font-family:'Oswald',sans-serif;font-weight:700;font-size:24px;line-height:1.05;text-transform:uppercase;color:#fff\">Season introduction<\u002Fdiv>\n            <div style=\"font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:0.06em;text-transform:uppercase;color:#F2C25B;margin-top:4px\">Build the foundation: build the team<\u002Fdiv>\n          <\u002Fdiv>\n          <div style=\"padding:20px\">\n            <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:8px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#E0A526\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:16px;height:16px;flex-shrink:0;display:block\"><circle cx=\"12\" cy=\"12\" r=\"10\"><\u002Fcircle><circle cx=\"12\" cy=\"12\" r=\"6\"><\u002Fcircle><circle cx=\"12\" cy=\"12\" r=\"2\"><\u002Fcircle><\u002Fsvg><span style=\"font-family:'Oswald',sans-serif;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#E0A526\">Objectives<\u002Fspan><\u002Fdiv>\n            <ul style=\"margin:0 0 20px;padding-left:18px;font-size:14px;line-height:1.6;color:#D8D2C8;display:grid;gap:6px\">\n              <li>Assess baseline fitness and individual skill sets<\u002Fli>\n              <li>Establish Team Culture traits into daily activities<\u002Fli>\n              <li>Develop Team Tactics framework for the season<\u002Fli>\n            <\u002Ful>\n            <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:8px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#E0A526\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:16px;height:16px;flex-shrink:0;display:block\"><path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"><\u002Fpath><\u002Fsvg><span style=\"font-family:'Oswald',sans-serif;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#E0A526\">Focus areas<\u002Fspan><\u002Fdiv>\n            <ul style=\"margin:0 0 20px;padding-left:18px;font-size:14px;line-height:1.6;color:#D8D2C8;display:grid;gap:6px\">\n              <li>Skate, Pass, Shoot, Checking skill drills<\u002Fli>\n              <li>Read &amp; React situational skills<\u002Fli>\n              <li>Up-tempo practices to set fitness (mental &amp; physical standards)<\u002Fli>\n              <li>Discuss leadership traits<\u002Fli>\n            <\u002Ful>\n            <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:8px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#E0A526\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:16px;height:16px;flex-shrink:0;display:block\"><rect width=\"8\" height=\"4\" x=\"8\" y=\"2\" rx=\"1\"><\u002Frect><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"><\u002Fpath><path d=\"M12 11h4\"><\u002Fpath><path d=\"M12 16h4\"><\u002Fpath><path d=\"M8 11h.01\"><\u002Fpath><path d=\"M8 16h.01\"><\u002Fpath><\u002Fsvg><span style=\"font-family:'Oswald',sans-serif;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#E0A526\">Sample activities<\u002Fspan><\u002Fdiv>\n            <ul style=\"margin:0;padding-left:18px;font-size:14px;line-height:1.6;color:#D8D2C8;display:grid;gap:6px\">\n              <li>EdgeBoss Hockey training sessions<\u002Fli>\n              <li>Team-building oriented training sessions<\u002Fli>\n              <li>Challenge the players to get (un)comfortable<\u002Fli>\n            <\u002Ful>\n          <\u002Fdiv>\n        <\u002Fdiv>\n\n        <div style=\"background:#151312;border:1px solid #2A2620\">\n          <div style=\"background:#1B3A5C;padding:16px 20px\">\n            <div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:10px;font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:0.16em;text-transform:uppercase;color:#F2C25B;margin-bottom:6px\"><span>Phase 2<\u002Fspan><span>Oct–Dec<\u002Fspan><\u002Fdiv>\n            <div style=\"font-family:'Oswald',sans-serif;font-weight:700;font-size:24px;line-height:1.05;text-transform:uppercase;color:#fff\">Early season development<\u002Fdiv>\n            <div style=\"font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:0.06em;text-transform:uppercase;color:#F2C25B;margin-top:4px\">Play connected<\u002Fdiv>\n          <\u002Fdiv>\n          <div style=\"padding:20px\">\n            <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:8px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#E0A526\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:16px;height:16px;flex-shrink:0;display:block\"><circle cx=\"12\" cy=\"12\" r=\"10\"><\u002Fcircle><circle cx=\"12\" cy=\"12\" r=\"6\"><\u002Fcircle><circle cx=\"12\" cy=\"12\" r=\"2\"><\u002Fcircle><\u002Fsvg><span style=\"font-family:'Oswald',sans-serif;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#E0A526\">Objectives<\u002Fspan><\u002Fdiv>\n            <ul style=\"margin:0 0 20px;padding-left:18px;font-size:14px;line-height:1.6;color:#D8D2C8;display:grid;gap:6px\">\n              <li>Elevate Team Tactics understanding &amp; consistency<\u002Fli>\n              <li>Support the play on both sides of the puck<\u002Fli>\n              <li>Understand leadership expectations of each player<\u002Fli>\n            <\u002Ful>\n            <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:8px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#E0A526\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:16px;height:16px;flex-shrink:0;display:block\"><path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"><\u002Fpath><\u002Fsvg><span style=\"font-family:'Oswald',sans-serif;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#E0A526\">Focus areas<\u002Fspan><\u002Fdiv>\n            <ul style=\"margin:0 0 20px;padding-left:18px;font-size:14px;line-height:1.6;color:#D8D2C8;display:grid;gap:6px\">\n              <li>Forward line combinations and defensive pairings take shape<\u002Fli>\n              <li>Transition the play through puck recovery techniques<\u002Fli>\n              <li>Introduce and develop special teams<\u002Fli>\n              <li>Recognize acts of leadership and opportunities<\u002Fli>\n            <\u002Ful>\n            <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:8px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#E0A526\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:16px;height:16px;flex-shrink:0;display:block\"><rect width=\"8\" height=\"4\" x=\"8\" y=\"2\" rx=\"1\"><\u002Frect><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"><\u002Fpath><path d=\"M12 11h4\"><\u002Fpath><path d=\"M12 16h4\"><\u002Fpath><path d=\"M8 11h.01\"><\u002Fpath><path d=\"M8 16h.01\"><\u002Fpath><\u002Fsvg><span style=\"font-family:'Oswald',sans-serif;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#E0A526\">Sample activities<\u002Fspan><\u002Fdiv>\n            <ul style=\"margin:0;padding-left:18px;font-size:14px;line-height:1.6;color:#D8D2C8;display:grid;gap:6px\">\n              <li>Backchecking &amp; forechecking drills<\u002Fli>\n              <li>Puck retention skills<\u002Fli>\n              <li>Line changes and communication drills<\u002Fli>\n            <\u002Ful>\n          <\u002Fdiv>\n        <\u002Fdiv>\n\n        <div style=\"background:#151312;border:1px solid #2A2620\">\n          <div style=\"background:#2C4F3E;padding:16px 20px\">\n            <div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:10px;font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:0.16em;text-transform:uppercase;color:#F2C25B;margin-bottom:6px\"><span>Phase 3<\u002Fspan><span>Jan–Feb<\u002Fspan><\u002Fdiv>\n            <div style=\"font-family:'Oswald',sans-serif;font-weight:700;font-size:24px;line-height:1.05;text-transform:uppercase;color:#fff\">Mid-season intensification<\u002Fdiv>\n            <div style=\"font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:0.06em;text-transform:uppercase;color:#F2C25B;margin-top:4px\">Create the opportunities<\u002Fdiv>\n          <\u002Fdiv>\n          <div style=\"padding:20px\">\n            <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:8px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#E0A526\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:16px;height:16px;flex-shrink:0;display:block\"><circle cx=\"12\" cy=\"12\" r=\"10\"><\u002Fcircle><circle cx=\"12\" cy=\"12\" r=\"6\"><\u002Fcircle><circle cx=\"12\" cy=\"12\" r=\"2\"><\u002Fcircle><\u002Fsvg><span style=\"font-family:'Oswald',sans-serif;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#E0A526\">Objectives<\u002Fspan><\u002Fdiv>\n            <ul style=\"margin:0 0 20px;padding-left:18px;font-size:14px;line-height:1.6;color:#D8D2C8;display:grid;gap:6px\">\n              <li>Cement structure and execution under stress<\u002Fli>\n              <li>Foster leadership in-game and in the room<\u002Fli>\n              <li>Find ways to \"Level Up\" our game<\u002Fli>\n            <\u002Ful>\n            <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:8px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#E0A526\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:16px;height:16px;flex-shrink:0;display:block\"><path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"><\u002Fpath><\u002Fsvg><span style=\"font-family:'Oswald',sans-serif;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#E0A526\">Focus areas<\u002Fspan><\u002Fdiv>\n            <ul style=\"margin:0 0 20px;padding-left:18px;font-size:14px;line-height:1.6;color:#D8D2C8;display:grid;gap:6px\">\n              <li>Deceive the opposition<\u002Fli>\n              <li>Use faceoff plays<\u002Fli>\n              <li>Lockdown defensively<\u002Fli>\n              <li>Identify leaders through responsibilities and opportunities<\u002Fli>\n            <\u002Ful>\n            <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:8px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#E0A526\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:16px;height:16px;flex-shrink:0;display:block\"><rect width=\"8\" height=\"4\" x=\"8\" y=\"2\" rx=\"1\"><\u002Frect><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"><\u002Fpath><path d=\"M12 11h4\"><\u002Fpath><path d=\"M12 16h4\"><\u002Fpath><path d=\"M8 11h.01\"><\u002Fpath><path d=\"M8 16h.01\"><\u002Fpath><\u002Fsvg><span style=\"font-family:'Oswald',sans-serif;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#E0A526\">Sample activities<\u002Fspan><\u002Fdiv>\n            <ul style=\"margin:0;padding-left:18px;font-size:14px;line-height:1.6;color:#D8D2C8;display:grid;gap:6px\">\n              <li>Competitive scrimmages with coaching feedback<\u002Fli>\n              <li>Scenario-based drills (urgent breakouts, protecting leads)<\u002Fli>\n              <li>1-on-1 check-ins on roles and growth<\u002Fli>\n              <li>Attend higher level practices for mentoring opportunities<\u002Fli>\n            <\u002Ful>\n          <\u002Fdiv>\n        <\u002Fdiv>\n\n        <div style=\"background:#151312;border:1px solid #2A2620\">\n          <div style=\"background:#8A6412;padding:16px 20px\">\n            <div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:10px;font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:0.16em;text-transform:uppercase;color:#F2C25B;margin-bottom:6px\"><span>Phase 4<\u002Fspan><span>February<\u002Fspan><\u002Fdiv>\n            <div style=\"font-family:'Oswald',sans-serif;font-weight:700;font-size:24px;line-height:1.05;text-transform:uppercase;color:#fff\">Playoff preparation<\u002Fdiv>\n            <div style=\"font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:0.06em;text-transform:uppercase;color:#F2C25B;margin-top:4px\">Peak performance<\u002Fdiv>\n          <\u002Fdiv>\n          <div style=\"padding:20px\">\n            <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:8px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#E0A526\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:16px;height:16px;flex-shrink:0;display:block\"><circle cx=\"12\" cy=\"12\" r=\"10\"><\u002Fcircle><circle cx=\"12\" cy=\"12\" r=\"6\"><\u002Fcircle><circle cx=\"12\" cy=\"12\" r=\"2\"><\u002Fcircle><\u002Fsvg><span style=\"font-family:'Oswald',sans-serif;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#E0A526\">Objectives<\u002Fspan><\u002Fdiv>\n            <ul style=\"margin:0 0 20px;padding-left:18px;font-size:14px;line-height:1.6;color:#D8D2C8;display:grid;gap:6px\">\n              <li>No new systems<\u002Fli>\n              <li>Teach recovery, composure, and pressure management<\u002Fli>\n              <li>Understand self motivation, roles, discipline to peak performance<\u002Fli>\n            <\u002Ful>\n            <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:8px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#E0A526\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:16px;height:16px;flex-shrink:0;display:block\"><path d=\"M22 12h-4l-3 9L9 3l-3 9H2\"><\u002Fpath><\u002Fsvg><span style=\"font-family:'Oswald',sans-serif;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#E0A526\">Focus areas<\u002Fspan><\u002Fdiv>\n            <ul style=\"margin:0 0 20px;padding-left:18px;font-size:14px;line-height:1.6;color:#D8D2C8;display:grid;gap:6px\">\n              <li>High tempo familiar drills for flow state development<\u002Fli>\n              <li>Visualization skills + emotional regulation<\u002Fli>\n              <li>Preparation &amp; focus<\u002Fli>\n              <li>Player led leadership culture<\u002Fli>\n            <\u002Ful>\n            <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:8px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#E0A526\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:16px;height:16px;flex-shrink:0;display:block\"><rect width=\"8\" height=\"4\" x=\"8\" y=\"2\" rx=\"1\"><\u002Frect><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"><\u002Fpath><path d=\"M12 11h4\"><\u002Fpath><path d=\"M12 16h4\"><\u002Fpath><path d=\"M8 11h.01\"><\u002Fpath><path d=\"M8 16h.01\"><\u002Fpath><\u002Fsvg><span style=\"font-family:'Oswald',sans-serif;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#E0A526\">Sample activities<\u002Fspan><\u002Fdiv>\n            <ul style=\"margin:0;padding-left:18px;font-size:14px;line-height:1.6;color:#D8D2C8;display:grid;gap:6px\">\n              <li>Loose &amp; fun practice sessions<\u002Fli>\n              <li>Team meetings to lock in expectations<\u002Fli>\n            <\u002Ful>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <section id=\"standards\" data-screen-label=\"04 Standards\" style=\"padding:76px 28px;background:#F5F1EA;color:#121821\">\n    <div style=\"max-width:1000px;margin:0 auto\">\n      <div style=\"font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:0.26em;text-transform:uppercase;color:#B3161C;margin-bottom:10px\">Love the game. Be a great teammate. Work hard.<\u002Fdiv>\n      <h2 style=\"font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(34px,5vw,54px);line-height:1;text-transform:uppercase;margin:0 0 6px\">Standards &amp; expectations<\u002Fh2>\n      <div style=\"width:72px;height:3px;background:#E0A526;margin-bottom:34px\"><\u002Fdiv>\n\n      <div style=\"display:grid;gap:2px;background:#DCD5C8;border:1px solid #DCD5C8\">\n        <div style=\"display:grid;grid-template-columns:64px 1fr;background:#fff\">\n          <div style=\"background:#8E1218;color:#fff;font-family:'Oswald',sans-serif;font-weight:700;font-size:32px;display:flex;align-items:center;justify-content:center\">1<\u002Fdiv>\n          <div style=\"padding:20px 24px\">\n            <div style=\"display:flex;align-items:center;gap:12px;margin:0 0 10px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#B3161C\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:24px;height:24px;flex-shrink:0;display:block\"><path d=\"M13 4h3a2 2 0 0 1 2 2v14\"><\u002Fpath><path d=\"M2 20h3\"><\u002Fpath><path d=\"M13 20h9\"><\u002Fpath><path d=\"M10 12v.01\"><\u002Fpath><path d=\"M13 4.56v16.16a1 1 0 0 1-1.24.97L5 20V5.56a2 2 0 0 1 1.52-1.94l4-1A2 2 0 0 1 13 4.56Z\"><\u002Fpath><\u002Fsvg><h3 style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:22px;line-height:1.1;text-transform:uppercase;color:#B3161C;margin:0\">Locker room access<\u002Fh3><\u002Fdiv>\n            <p style=\"margin:0;font-size:15.5px;line-height:1.6;color:#3A3630\">Players and Coaches only in the locker room.<\u002Fp>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"display:grid;grid-template-columns:64px 1fr;background:#fff\">\n          <div style=\"background:#8E1218;color:#fff;font-family:'Oswald',sans-serif;font-weight:700;font-size:32px;display:flex;align-items:center;justify-content:center\">2<\u002Fdiv>\n          <div style=\"padding:20px 24px\">\n            <div style=\"display:flex;align-items:center;gap:12px;margin:0 0 10px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#B3161C\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:24px;height:24px;flex-shrink:0;display:block\"><circle cx=\"12\" cy=\"12\" r=\"10\"><\u002Fcircle><polyline points=\"12 6 12 12 16 14\"><\u002Fpolyline><\u002Fsvg><h3 style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:22px;line-height:1.1;text-transform:uppercase;color:#B3161C;margin:0\">Start on time<\u002Fh3><\u002Fdiv>\n            <p style=\"margin:0 0 6px;font-size:15.5px;line-height:1.6;color:#3A3630\">Practices: arrive to the locker room 45 minutes prior to ice time. Exceptions understood for traffic and school commitments — please notify a coach.<\u002Fp>\n            <p style=\"margin:0;font-size:15.5px;line-height:1.6;color:#3A3630\">Games: arrive to the locker room 60 minutes prior to game time, prepared with dryland/base layer for dynamic warmup.<\u002Fp>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"display:grid;grid-template-columns:64px 1fr;background:#fff\">\n          <div style=\"background:#8E1218;color:#fff;font-family:'Oswald',sans-serif;font-weight:700;font-size:32px;display:flex;align-items:center;justify-content:center\">3<\u002Fdiv>\n          <div style=\"padding:20px 24px\">\n            <div style=\"display:flex;align-items:center;gap:12px;margin:0 0 10px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#B3161C\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:24px;height:24px;flex-shrink:0;display:block\"><path d=\"M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z\"><\u002Fpath><\u002Fsvg><h3 style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:22px;line-height:1.1;text-transform:uppercase;color:#B3161C;margin:0\">Dress code<\u002Fh3><\u002Fdiv>\n            <p style=\"margin:0;font-size:15.5px;line-height:1.6;color:#3A3630\">Team jacket or track suit.<\u002Fp>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"display:grid;grid-template-columns:64px 1fr;background:#fff\">\n          <div style=\"background:#8E1218;color:#fff;font-family:'Oswald',sans-serif;font-weight:700;font-size:32px;display:flex;align-items:center;justify-content:center\">4<\u002Fdiv>\n          <div style=\"padding:20px 24px\">\n            <div style=\"display:flex;align-items:center;gap:12px;margin:0 0 10px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#B3161C\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:24px;height:24px;flex-shrink:0;display:block\"><path d=\"M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z\"><\u002Fpath><\u002Fsvg><h3 style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:22px;line-height:1.1;text-transform:uppercase;color:#B3161C;margin:0\">Illness<\u002Fh3><\u002Fdiv>\n            <p style=\"margin:0;font-size:15.5px;line-height:1.6;color:#3A3630\">If your player is unwell, please do not attend — even to watch or support.<\u002Fp>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"display:grid;grid-template-columns:64px 1fr;background:#fff\">\n          <div style=\"background:#8E1218;color:#fff;font-family:'Oswald',sans-serif;font-weight:700;font-size:32px;display:flex;align-items:center;justify-content:center\">5<\u002Fdiv>\n          <div style=\"padding:20px 24px\">\n            <div style=\"display:flex;align-items:center;gap:12px;margin:0 0 10px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#B3161C\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:24px;height:24px;flex-shrink:0;display:block\"><path d=\"M3.5 7.2c0-2.7 3.8-4.4 8.5-4.4s8.5 1.7 8.5 4.4c0 4.2-1.6 8-3.4 10.6-1.1 1.6-2.5 2.4-5.1 2.4s-4-.8-5.1-2.4C5.1 15.2 3.5 11.4 3.5 7.2Z\"><\u002Fpath><path d=\"M7 8.4c1.4-.8 3-1.2 5-1.2s3.6.4 5 1.2\"><\u002Fpath><\u002Fsvg><h3 style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:22px;line-height:1.1;text-transform:uppercase;color:#B3161C;margin:0\">Mouthguards<\u002Fh3><\u002Fdiv>\n            <p style=\"margin:0;font-size:15.5px;line-height:1.6;color:#3A3630\">There is incidental and deliberate contact in HSL; mouthguards reduce injuries.<\u002Fp>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"display:grid;grid-template-columns:64px 1fr;background:#fff\">\n          <div style=\"background:#8E1218;color:#fff;font-family:'Oswald',sans-serif;font-weight:700;font-size:32px;display:flex;align-items:center;justify-content:center\">6<\u002Fdiv>\n          <div style=\"padding:20px 24px\">\n            <div style=\"display:flex;align-items:center;gap:12px;margin:0 0 10px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#B3161C\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:24px;height:24px;flex-shrink:0;display:block\"><path d=\"M8 2v4\"><\u002Fpath><path d=\"M16 2v4\"><\u002Fpath><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\"><\u002Frect><path d=\"M3 10h18\"><\u002Fpath><path d=\"m9 16 2 2 4-4\"><\u002Fpath><\u002Fsvg><h3 style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:22px;line-height:1.1;text-transform:uppercase;color:#B3161C;margin:0\">Use TeamSnap for attendance<\u002Fh3><\u002Fdiv>\n            <p style=\"margin:0;font-size:15.5px;line-height:1.6;color:#3A3630\">Communicate attendance and absences through TeamSnap.<\u002Fp>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"display:grid;grid-template-columns:64px 1fr;background:#fff\">\n          <div style=\"background:#8E1218;color:#fff;font-family:'Oswald',sans-serif;font-weight:700;font-size:32px;display:flex;align-items:center;justify-content:center\">7<\u002Fdiv>\n          <div style=\"padding:20px 24px\">\n            <div style=\"display:flex;align-items:center;gap:12px;margin:0 0 10px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#B3161C\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:24px;height:24px;flex-shrink:0;display:block\"><polygon points=\"11 5 6 9 2 9 2 15 6 15 11 19 11 5\"><\u002Fpolygon><line x1=\"22\" x2=\"16\" y1=\"9\" y2=\"15\"><\u002Fline><line x1=\"16\" x2=\"22\" y1=\"9\" y2=\"15\"><\u002Fline><\u002Fsvg><h3 style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:22px;line-height:1.1;text-transform:uppercase;color:#B3161C;margin:0\">Be bigger than the noise<\u002Fh3><\u002Fdiv>\n            <p style=\"margin:0;font-size:15.5px;line-height:1.6;color:#3A3630\">We won't be perfect on the ice, and neither will others — let the kids play.<\u002Fp>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"display:grid;grid-template-columns:64px 1fr;background:#fff\">\n          <div style=\"background:#8E1218;color:#fff;font-family:'Oswald',sans-serif;font-weight:700;font-size:32px;display:flex;align-items:center;justify-content:center\">8<\u002Fdiv>\n          <div style=\"padding:20px 24px\">\n            <div style=\"display:flex;align-items:center;gap:12px;margin:0 0 10px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#B3161C\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:24px;height:24px;flex-shrink:0;display:block\"><path d=\"M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z\"><\u002Fpath><\u002Fsvg><h3 style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:22px;line-height:1.1;text-transform:uppercase;color:#B3161C;margin:0\">Cheer for everyone<\u002Fh3><\u002Fdiv>\n            <p style=\"margin:0;font-size:15.5px;line-height:1.6;color:#3A3630\">No negative talk about teammates — on the ice, in the car, or in the stands.<\u002Fp>\n          <\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"display:grid;grid-template-columns:64px 1fr;background:#fff\">\n          <div style=\"background:#8E1218;color:#fff;font-family:'Oswald',sans-serif;font-weight:700;font-size:32px;display:flex;align-items:center;justify-content:center\">9<\u002Fdiv>\n          <div style=\"padding:20px 24px\">\n            <div style=\"display:flex;align-items:center;gap:12px;margin:0 0 10px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#B3161C\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:24px;height:24px;flex-shrink:0;display:block\"><path d=\"M7.9 20A9 9 0 1 0 4 16.1L2 22Z\"><\u002Fpath><\u002Fsvg><h3 style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:22px;line-height:1.1;text-transform:uppercase;color:#B3161C;margin:0\">Seek to understand first<\u002Fh3><\u002Fdiv>\n            <p style=\"margin:0;font-size:15.5px;line-height:1.6;color:#3A3630\">Whether it's a role, a decision, or a challenge — lead with curiosity.<\u002Fp>\n          <\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <section id=\"drills\" data-screen-label=\"05 Common drills\" style=\"padding:76px 28px;background:#0B0B0D;border-top:3px solid #E0A526\">\n    <div style=\"max-width:1180px;margin:0 auto\">\n      <div style=\"font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:0.26em;text-transform:uppercase;color:#E0A526;margin-bottom:10px\">Develop skills. Build IQ. Compete.<\u002Fdiv>\n      <h2 style=\"font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(34px,5vw,54px);line-height:1;text-transform:uppercase;margin:0 0 26px;color:#F5F1EA\">Common Crusaders drills<\u002Fh2>\n\n      <div style=\"border:1px solid #E0A526;padding:18px 20px;margin-bottom:30px;display:grid;grid-template-columns:repeat(auto-fit,minmax(112px,1fr));gap:16px\">\n        <sc-for list=\"{{ cats }}\" as=\"c\" hint-placeholder-count=\"9\">\n          <div style=\"display:flex;flex-direction:column;align-items:center;gap:8px;text-align:center\">\n            <span style=\"width:44px;height:44px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:{{ c.solid }}\">\n              <svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:24px;height:24px;display:block\"><path d=\"{{ c.icon }}\"><\u002Fpath><\u002Fsvg>\n            <\u002Fspan>\n            <span style=\"font-family:'Oswald',sans-serif;font-size:11.5px;line-height:1.25;letter-spacing:0.08em;text-transform:uppercase;color:#D8D2C8\">{{ c.label }}<\u002Fspan>\n          <\u002Fdiv>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(215px,1fr));gap:14px\">\n        <sc-for list=\"{{ drills }}\" as=\"d\" hint-placeholder-count=\"23\">\n          <div style=\"background:#F5F1EA;color:#121821;padding:16px 16px 18px;display:flex;flex-direction:column;gap:10px\">\n            <div style=\"display:flex;align-items:center;gap:10px\">\n              <span style=\"background:#B3161C;color:#fff;font-family:'Oswald',sans-serif;font-weight:600;font-size:14px;min-width:26px;height:26px;display:flex;align-items:center;justify-content:center\">{{ d.n }}<\u002Fspan>\n              <span style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:17px;line-height:1.1;text-transform:uppercase\">{{ d.name }}<\u002Fspan>\n            <\u002Fdiv>\n            <div style=\"display:flex;flex-direction:column;align-items:flex-start;gap:6px\">\n              <sc-for list=\"{{ d.tags }}\" as=\"t\" hint-placeholder-count=\"4\">\n                <span style=\"font-size:12px;line-height:1;padding:5px 9px 5px 7px;border-radius:999px;font-weight:600;display:inline-flex;align-items:center;gap:5px;background:{{ t.bg }};color:{{ t.fg }}\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"{{ t.fg }}\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:13px;height:13px;flex-shrink:0;display:block\"><path d=\"{{ t.icon }}\"><\u002Fpath><\u002Fsvg>{{ t.label }}<\u002Fspan>\n              <\u002Fsc-for>\n            <\u002Fdiv>\n          <\u002Fdiv>\n        <\u002Fsc-for>\n        <div style=\"background:#151312;border:1px solid #E0A526;padding:20px 18px;display:flex;flex-direction:column;justify-content:center;gap:8px\">\n          <img src=\"13793e81-cb1a-4c2a-af1b-2dc813e4c1f6\" alt=\"\" style=\"width:56px;height:56px;object-fit:contain\">\n          <div style=\"font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:0.2em;text-transform:uppercase;color:#E0A526\"><div style=\"display:flex;flex-direction:column;align-items:center;gap:8px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#E0A526\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:22px;height:22px;flex-shrink:0;display:block\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"><\u002Fpath><\u002Fsvg><span>One purpose.<\u002Fspan><\u002Fdiv><\u002Fdiv>\n          <div style=\"font-family:'Oswald',sans-serif;font-weight:700;font-size:26px;line-height:1;text-transform:uppercase;color:#F5F1EA\">Crusader hockey.<\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n\n      <div style=\"margin-top:30px;display:flex;flex-wrap:wrap;gap:0;justify-content:center;border-top:1px solid #2A2620;padding-top:22px;font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:0.22em;text-transform:uppercase;color:#E0A526\">\n        <span style=\"padding:0 16px;display:flex;align-items:center;gap:10px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#E0A526\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:18px;height:18px;flex-shrink:0;display:block\"><path d=\"m8 3 4 8 5-5 5 15H2L8 3z\"><\u002Fpath><\u002Fsvg>Discipline<\u002Fspan><span style=\"padding:0 16px;border-left:1px solid #2A2620\">Respect<\u002Fspan><span style=\"padding:0 16px;border-left:1px solid #2A2620\">Accountability<\u002Fspan><span style=\"padding:0 16px;border-left:1px solid #2A2620\">Passion<\u002Fspan><span style=\"padding:0 16px;border-left:1px solid #2A2620\">Trust<\u002Fspan>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <section id=\"form\" data-screen-label=\"06 Player form\" style=\"padding:76px 28px;background:#F5F1EA;color:#121821\">\n    <div style=\"max-width:980px;margin:0 auto\">\n      <div style=\"font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:0.26em;text-transform:uppercase;color:#B3161C;margin-bottom:10px\">Player profile<\u002Fdiv>\n      <h2 style=\"font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(34px,5vw,54px);line-height:1;text-transform:uppercase;margin:0 0 12px\">Get to know you<\u002Fh2>\n      <p style=\"font-size:17px;line-height:1.6;max-width:60ch;margin:0 0 8px;color:#3A3630\">Fill this out to help us get to know you — and to capture a snapshot of who you are this season.<\u002Fp>\n      <p style=\"font-size:14px;line-height:1.6;margin:0 0 30px;color:#7A7266\">Your answers save automatically in this browser. Use <strong>Print / save as PDF<\u002Fstrong> when you're done and send it to a coach.<\u002Fp>\n\n      <div style=\"background:#fff;border-top:3px solid #B3161C;padding:26px 24px;margin-bottom:18px;box-shadow:0 1px 3px rgba(18,24,33,0.08)\">\n        <h3 style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:21px;letter-spacing:0.06em;text-transform:uppercase;color:#B3161C;margin:0 0 20px\">Player info<\u002Fh3>\n        <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px 26px\">\n          <label style=\"display:grid;gap:6px;font-size:14px;color:#3A3630\">Full name\n            <input type=\"text\" value=\"{{ f.fullName }}\" sc-camel-on-change=\"{{ set.fullName }}\" style=\"font-size:16px;padding:10px 12px;border:1px solid #DCD5C8;border-radius:4px;background:#FBF9F5;color:#121821\">\n          <\u002Flabel>\n          <label style=\"display:grid;gap:6px;font-size:14px;color:#3A3630\">Jersey number\n            <input type=\"text\" value=\"{{ f.jersey }}\" sc-camel-on-change=\"{{ set.jersey }}\" style=\"font-size:16px;padding:10px 12px;border:1px solid #DCD5C8;border-radius:4px;background:#FBF9F5;color:#121821\">\n          <\u002Flabel>\n          <label style=\"display:grid;gap:6px;font-size:14px;color:#3A3630\">Birthday\n            <input type=\"text\" value=\"{{ f.birthday }}\" sc-camel-on-change=\"{{ set.birthday }}\" placeholder=\"e.g. March 4, 2016\" style=\"font-size:16px;padding:10px 12px;border:1px solid #DCD5C8;border-radius:4px;background:#FBF9F5;color:#121821\">\n          <\u002Flabel>\n          <label style=\"display:grid;gap:6px;font-size:14px;color:#3A3630\">Favourite position\n            <input type=\"text\" value=\"{{ f.position }}\" sc-camel-on-change=\"{{ set.position }}\" style=\"font-size:16px;padding:10px 12px;border:1px solid #DCD5C8;border-radius:4px;background:#FBF9F5;color:#121821\">\n          <\u002Flabel>\n          <label style=\"display:grid;gap:6px;font-size:14px;color:#3A3630\">Height\n            <input type=\"text\" value=\"{{ f.height }}\" sc-camel-on-change=\"{{ set.height }}\" style=\"font-size:16px;padding:10px 12px;border:1px solid #DCD5C8;border-radius:4px;background:#FBF9F5;color:#121821\">\n          <\u002Flabel>\n          <label style=\"display:grid;gap:6px;font-size:14px;color:#3A3630\">Weight\n            <input type=\"text\" value=\"{{ f.weight }}\" sc-camel-on-change=\"{{ set.weight }}\" style=\"font-size:16px;padding:10px 12px;border:1px solid #DCD5C8;border-radius:4px;background:#FBF9F5;color:#121821\">\n          <\u002Flabel>\n          <label style=\"display:grid;gap:6px;font-size:14px;color:#3A3630\">Shoots\n            <input type=\"text\" value=\"{{ f.shoots }}\" sc-camel-on-change=\"{{ set.shoots }}\" placeholder=\"Left or right\" style=\"font-size:16px;padding:10px 12px;border:1px solid #DCD5C8;border-radius:4px;background:#FBF9F5;color:#121821\">\n          <\u002Flabel>\n          <label style=\"display:grid;gap:6px;font-size:14px;color:#B3161C\">Goalies — catches\n            <input type=\"text\" value=\"{{ f.catches }}\" sc-camel-on-change=\"{{ set.catches }}\" placeholder=\"Left or right\" style=\"font-size:16px;padding:10px 12px;border:1px solid #DCD5C8;border-radius:4px;background:#FBF9F5;color:#121821\">\n          <\u002Flabel>\n        <\u002Fdiv>\n      <\u002Fdiv>\n\n      <div style=\"background:#fff;border-top:3px solid #B3161C;padding:26px 24px;margin-bottom:18px;box-shadow:0 1px 3px rgba(18,24,33,0.08)\">\n        <h3 style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:21px;letter-spacing:0.06em;text-transform:uppercase;color:#B3161C;margin:0 0 20px\">Quick facts<\u002Fh3>\n        <div style=\"display:grid;gap:18px\">\n          <label style=\"display:grid;gap:6px;font-size:14px;color:#3A3630\">Favourite food\n            <input type=\"text\" value=\"{{ f.food }}\" sc-camel-on-change=\"{{ set.food }}\" style=\"font-size:16px;padding:10px 12px;border:1px solid #DCD5C8;border-radius:4px;background:#FBF9F5;color:#121821\">\n          <\u002Flabel>\n          <label style=\"display:grid;gap:6px;font-size:14px;color:#3A3630\">Favourite NHL team\n            <input type=\"text\" value=\"{{ f.nhlTeam }}\" sc-camel-on-change=\"{{ set.nhlTeam }}\" style=\"font-size:16px;padding:10px 12px;border:1px solid #DCD5C8;border-radius:4px;background:#FBF9F5;color:#121821\">\n          <\u002Flabel>\n          <label style=\"display:grid;gap:6px;font-size:14px;color:#3A3630\">Favourite NHL player\n            <input type=\"text\" value=\"{{ f.nhlPlayer }}\" sc-camel-on-change=\"{{ set.nhlPlayer }}\" style=\"font-size:16px;padding:10px 12px;border:1px solid #DCD5C8;border-radius:4px;background:#FBF9F5;color:#121821\">\n          <\u002Flabel>\n          <label style=\"display:grid;gap:6px;font-size:14px;color:#3A3630\">Other sport you love (besides hockey)\n            <input type=\"text\" value=\"{{ f.otherSport }}\" sc-camel-on-change=\"{{ set.otherSport }}\" style=\"font-size:16px;padding:10px 12px;border:1px solid #DCD5C8;border-radius:4px;background:#FBF9F5;color:#121821\">\n          <\u002Flabel>\n          <label style=\"display:grid;gap:6px;font-size:14px;color:#3A3630\">Favourite subject in school\n            <input type=\"text\" value=\"{{ f.subject }}\" sc-camel-on-change=\"{{ set.subject }}\" style=\"font-size:16px;padding:10px 12px;border:1px solid #DCD5C8;border-radius:4px;background:#FBF9F5;color:#121821\">\n          <\u002Flabel>\n          <label style=\"display:grid;gap:6px;font-size:14px;color:#3A3630\">Music or hype song before games\n            <input type=\"text\" value=\"{{ f.hypeSong }}\" sc-camel-on-change=\"{{ set.hypeSong }}\" style=\"font-size:16px;padding:10px 12px;border:1px solid #DCD5C8;border-radius:4px;background:#FBF9F5;color:#121821\">\n          <\u002Flabel>\n        <\u002Fdiv>\n      <\u002Fdiv>\n\n      <div style=\"background:#fff;border-top:3px solid #B3161C;padding:26px 24px;box-shadow:0 1px 3px rgba(18,24,33,0.08)\">\n        <h3 style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:21px;letter-spacing:0.06em;text-transform:uppercase;color:#B3161C;margin:0 0 20px\">In your words<\u002Fh3>\n        <div style=\"display:grid;gap:20px\">\n          <label style=\"display:grid;gap:8px;font-size:15.5px;color:#121821\">What do you love most about hockey?\n            <textarea rows=\"3\" value=\"{{ f.loveMost }}\" sc-camel-on-change=\"{{ set.loveMost }}\" style=\"font-size:16px;line-height:1.6;padding:12px;border:1px solid #DCD5C8;border-radius:4px;background:#FBF9F5;color:#121821;resize:vertical\"><\u002Ftextarea>\n          <\u002Flabel>\n          <label style=\"display:grid;gap:8px;font-size:15.5px;color:#121821\">What does being a great teammate mean to you?\n            <textarea rows=\"3\" value=\"{{ f.teammate }}\" sc-camel-on-change=\"{{ set.teammate }}\" style=\"font-size:16px;line-height:1.6;padding:12px;border:1px solid #DCD5C8;border-radius:4px;background:#FBF9F5;color:#121821;resize:vertical\"><\u002Ftextarea>\n          <\u002Flabel>\n          <label style=\"display:grid;gap:8px;font-size:15.5px;color:#121821\">What do you want to improve this season?\n            <textarea rows=\"3\" value=\"{{ f.improve }}\" sc-camel-on-change=\"{{ set.improve }}\" style=\"font-size:16px;line-height:1.6;padding:12px;border:1px solid #DCD5C8;border-radius:4px;background:#FBF9F5;color:#121821;resize:vertical\"><\u002Ftextarea>\n          <\u002Flabel>\n        <\u002Fdiv>\n        <div class=\"noprint\" style=\"display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:24px\">\n          <button sc-camel-on-click=\"{{ printForm }}\" style=\"font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:0.12em;text-transform:uppercase;padding:12px 22px;border:0;border-radius:4px;background:#B3161C;color:#fff;cursor:pointer\" style-hover=\"background:#8E1218\">Print / save as PDF<\u002Fbutton>\n          <button sc-camel-on-click=\"{{ clearForm }}\" style=\"font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:0.12em;text-transform:uppercase;padding:12px 22px;border:1px solid #C9C1B2;border-radius:4px;background:transparent;color:#3A3630;cursor:pointer\" style-hover=\"border-color:#B3161C;color:#B3161C\">Clear<\u002Fbutton>\n          <span style=\"font-size:13px;color:#7A7266\">{{ savedNote }}<\u002Fspan>\n        <\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <section id=\"contacts\" data-screen-label=\"07 Contacts\" style=\"padding:76px 28px;background:#0B0B0D;border-top:3px solid #E0A526\">\n    <div style=\"max-width:1000px;margin:0 auto\">\n      <div style=\"font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:0.26em;text-transform:uppercase;color:#E0A526;margin-bottom:10px\"><div style=\"display:flex;align-items:center;gap:12px\"><img src=\"13793e81-cb1a-4c2a-af1b-2dc813e4c1f6\" alt=\"\" style=\"width:34px;height:34px;object-fit:contain;display:block\"><span style=\"color:#E0A526\">One purpose. Crusader forever.<\u002Fspan><\u002Fdiv><\u002Fdiv>\n      <h2 style=\"font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(34px,5vw,54px);line-height:1;text-transform:uppercase;margin:0 0 30px;color:#F5F1EA\">Team contact list<\u002Fh2>\n\n      <div style=\"display:grid;gap:2px\">\n        <div style=\"display:grid;grid-template-columns:30px 1fr 1fr 1.9fr 0.8fr;gap:16px;background:#8E1218;padding:14px 20px;font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:0.16em;text-transform:uppercase;color:#fff\">\n          <span><\u002Fspan><span>Role<\u002Fspan><span>Name<\u002Fspan><span>Email<\u002Fspan><span>Phone<\u002Fspan>\n        <\u002Fdiv>\n        <sc-for list=\"{{ staff }}\" as=\"s\" hint-placeholder-count=\"6\">\n          <div style=\"display:grid;grid-template-columns:30px 1fr 1fr 1.9fr 0.8fr;gap:16px;background:#F5F1EA;color:#121821;padding:16px 20px;align-items:center\">\n            <svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#8E1218\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:22px;height:22px;display:block\"><path d=\"{{ s.icon }}\"><\u002Fpath><\u002Fsvg>\n            <span style=\"font-family:'Oswald',sans-serif;font-size:15px;letter-spacing:0.06em;text-transform:uppercase;color:#8E1218\">{{ s.role }}<\u002Fspan>\n            <span style=\"font-weight:600;font-size:15.5px\">{{ s.name }}<\u002Fspan>\n            <a href=\"{{ s.mailto }}\" style=\"font-size:14.5px;color:#1B3A5C;overflow-wrap:anywhere\">{{ s.email }}<\u002Fa>\n            <a href=\"{{ s.tel }}\" style=\"font-size:15px;font-variant-numeric:tabular-nums;color:#1B3A5C\">{{ s.phone }}<\u002Fa>\n          <\u002Fdiv>\n        <\u002Fsc-for>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <section id=\"final\" data-screen-label=\"08 Final word\" style=\"padding:76px 28px 0;background:#F5F1EA;color:#121821\">\n    <div style=\"max-width:1000px;margin:0 auto\">\n      <div style=\"font-family:'Oswald',sans-serif;font-size:14px;letter-spacing:0.26em;text-transform:uppercase;color:#B3161C;margin-bottom:10px\">2026–27 season<\u002Fdiv>\n      <h2 style=\"font-family:'Oswald',sans-serif;font-weight:700;font-size:clamp(34px,5vw,54px);line-height:1;text-transform:uppercase;margin:0 0 6px\">Final word<\u002Fh2>\n      <div style=\"width:72px;height:3px;background:#E0A526;margin-bottom:34px\"><\u002Fdiv>\n\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:28px;margin-bottom:44px\">\n        <div style=\"display:grid;gap:20px\">\n          <p style=\"margin:0;font-size:18px;line-height:1.7;text-wrap:pretty\">This season is about becoming the <strong style=\"color:#B3161C\">best version of yourself<\u002Fstrong> and helping your teammates do the same.<\u002Fp>\n          <p style=\"margin:0;font-size:18px;line-height:1.7;text-wrap:pretty\">Every practice is an opportunity to <strong style=\"color:#B3161C\">get a little better<\u002Fstrong>. Every game is an opportunity to <strong style=\"color:#B3161C\">learn<\u002Fstrong>. Every challenge is an opportunity to <strong style=\"color:#B3161C\">grow<\u002Fstrong>.<\u002Fp>\n        <\u002Fdiv>\n        <div style=\"display:grid;gap:20px\">\n          <p style=\"margin:0;font-size:18px;line-height:1.7;text-wrap:pretty\">We will work hard to become smarter hockey players by improving our skills, learning how to think the game, and trusting each other on the ice. We won't always be perfect, but we will always compete, support one another, and keep getting better.<\u002Fp>\n          <p style=\"margin:0;font-size:18px;line-height:1.7;text-wrap:pretty\">Remember, confidence doesn't come from hoping you play well. <strong style=\"color:#B3161C\">It comes from being prepared.<\u002Fstrong><\u002Fp>\n        <\u002Fdiv>\n      <\u002Fdiv>\n\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:2px;background:#DCD5C8;border:1px solid #DCD5C8;margin-bottom:38px\">\n        <div style=\"background:#fff;padding:28px 24px;text-align:center\">\n          <div style=\"display:flex;justify-content:center;margin-bottom:14px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#E0A526\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:34px;height:34px;flex-shrink:0;display:block\"><path d=\"M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.07-2.14-.22-4.05 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.15.43-2.29 1-3a2.5 2.5 0 0 0 2.5 2.5z\"><\u002Fpath><\u002Fsvg><\u002Fdiv><div style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:30px;text-transform:uppercase;margin-bottom:8px\">Be <span style=\"color:#B3161C\">brave<\u002Fspan><\u002Fdiv>\n          <div style=\"font-size:16px;color:#3A3630\">enough to try new things.<\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"background:#fff;padding:28px 24px;text-align:center\">\n          <div style=\"display:flex;justify-content:center;margin-bottom:14px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#E0A526\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:34px;height:34px;flex-shrink:0;display:block\"><path d=\"m6.5 6.5 11 11\"><\u002Fpath><path d=\"m21 21-1-1\"><\u002Fpath><path d=\"m3 3 1 1\"><\u002Fpath><path d=\"m18 22 4-4\"><\u002Fpath><path d=\"m2 6 4-4\"><\u002Fpath><path d=\"m3 10 7-7\"><\u002Fpath><path d=\"m14 21 7-7\"><\u002Fpath><\u002Fsvg><\u002Fdiv><div style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:30px;text-transform:uppercase;margin-bottom:8px\">Be <span style=\"color:#B3161C\">tough<\u002Fspan><\u002Fdiv>\n          <div style=\"font-size:16px;color:#3A3630\">enough to learn from mistakes.<\u002Fdiv>\n        <\u002Fdiv>\n        <div style=\"background:#fff;padding:28px 24px;text-align:center\">\n          <div style=\"display:flex;justify-content:center;margin-bottom:14px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#E0A526\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:34px;height:34px;flex-shrink:0;display:block\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"><\u002Fpath><circle cx=\"9\" cy=\"7\" r=\"4\"><\u002Fcircle><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"><\u002Fpath><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"><\u002Fpath><\u002Fsvg><\u002Fdiv><div style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:30px;text-transform:uppercase;margin-bottom:8px\">Be the <span style=\"color:#B3161C\">teammate<\u002Fspan><\u002Fdiv>\n          <div style=\"font-size:16px;color:#3A3630\">that others want beside them.<\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n\n      <div style=\"background:#8E1218;color:#fff;padding:30px 28px;text-align:center\">\n        <div style=\"display:flex;justify-content:center;margin-bottom:14px\"><svg sc-camel-view-box=\"0 0 24 24\" fill=\"none\" stroke=\"#F2C25B\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" style=\"width:34px;height:34px;flex-shrink:0;display:block\"><path d=\"M6 9H4.5a2.5 2.5 0 0 1 0-5H6\"><\u002Fpath><path d=\"M18 9h1.5a2.5 2.5 0 0 0 0-5H18\"><\u002Fpath><path d=\"M4 22h16\"><\u002Fpath><path d=\"M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22\"><\u002Fpath><path d=\"M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22\"><\u002Fpath><path d=\"M18 2H6v7a6 6 0 0 0 12 0V2z\"><\u002Fpath><\u002Fsvg><\u002Fdiv>\n        <div style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:clamp(20px,3vw,30px);line-height:1.25;text-transform:uppercase;text-wrap:pretty\">If we love the game, work hard, and put the team first, <span style=\"color:#F2C25B\">great things will happen.<\u002Fspan><\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"text-align:center;padding:34px 0 60px\">\n        <div style=\"font-family:'Oswald',sans-serif;font-weight:600;font-size:clamp(22px,3.4vw,34px);text-transform:uppercase;margin-bottom:12px\">Now let's go <span style=\"color:#B3161C\">build something special.<\u002Fspan><\u002Fdiv>\n        <div style=\"font-size:20px;font-style:italic;color:#3A3630\">— Coach Pars<\u002Fdiv>\n      <\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Fsection>\n\n  <footer style=\"background:#0B0B0D;border-top:3px solid #B3161C;padding:44px 28px 56px\">\n    <div style=\"max-width:1000px;margin:0 auto;display:flex;flex-wrap:wrap;gap:26px;align-items:center;justify-content:space-between\">\n      <div style=\"display:flex;align-items:center;gap:16px\">\n        <img src=\"13793e81-cb1a-4c2a-af1b-2dc813e4c1f6\" alt=\"Crusaders\" style=\"width:56px;height:56px;object-fit:contain\">\n        <div>\n          <div style=\"font-family:'Oswald',sans-serif;font-weight:700;font-size:20px;letter-spacing:0.08em;text-transform:uppercase;color:#F5F1EA\">Crusader hockey<\u002Fdiv>\n          <div style=\"font-family:'Oswald',sans-serif;font-size:13px;letter-spacing:0.18em;text-transform:uppercase;color:#E0A526\"><div style=\"display:flex;align-items:center;gap:12px\"><img src=\"13793e81-cb1a-4c2a-af1b-2dc813e4c1f6\" alt=\"\" style=\"width:34px;height:34px;object-fit:contain;display:block\"><span style=\"color:#E0A526\">One purpose. Crusader forever.<\u002Fspan><\u002Fdiv><\u002Fdiv>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div style=\"font-size:13px;color:#7A7266\">2016 Crusaders — 2026/27 HSL season program manual<\u002Fdiv>\n    <\u002Fdiv>\n  <\u002Ffooter>\n<\u002Fdiv>\n\n\n<\u002Fx-dc>\n<script type=\"text/x-dc\" data-dc-script=\"\" data-props=\"{}\">\nconst KEY = 'crusaders-player-form-v1';\nconst FIELDS = ['fullName','jersey','birthday','position','height','weight','shoots','catches','food','nhlTeam','nhlPlayer','otherSport','subject','hypeSong','loveMost','teammate','improve'];\n\nconst ICONS = {\n  pass:    'M8 3 4 7l4 4M4 7h16M16 21l4-4-4-4M20 17H4',\n  comm:    'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z',\n  skate:   'm13 17 5-5-5-5M6 17l5-5-5-5',\n  shoot:   'M12 2v4m0 12v4M2 12h4m12 0h4M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8',\n  iq:      'M9 18h6M10 22h4M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5',\n  trans:   'M21 12a9 9 0 1 1-2.6-6.4M21 3v6h-6',\n  def:     'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z',\n  special: 'M17 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9.5 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8M22 21v-2a4 4 0 0 0-3-3.9',\n  compete: 'M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.7V17c0 .6-.5 1-1 1.2C7.9 18.8 7 20.2 7 22M14 14.7V17c0 .6.5 1 1 1.2 1.1.6 2 2 2 4.8M18 2H6v7a6 6 0 0 0 12 0z'\n};\nconst CAT_LABELS = {\n  pass: 'Passing / receiving', comm: 'Communication', skate: 'Skating',\n  shoot: 'Shooting / scoring', iq: 'Hockey IQ (awareness)', trans: 'Transition',\n  def: 'Defensive', special: 'Special teams', compete: 'Compete / battle'\n};\nconst CAT_SOLID = {\n  pass: '#2D6CDF', comm: '#2E9E4F', skate: '#D9A02B', shoot: '#C4271F',\n  iq: '#7B4FA8', trans: '#E07B26', def: '#7A8290', special: '#1F7A8C', compete: '#3A3630'\n};\nconst CAT = {\n  pass:    ['#E3EBFA', '#1F4FA8', 'pass'],\n  comm:    ['#E2F1E7', '#1E6B36', 'comm'],\n  skate:   ['#F7ECD6', '#8A6412', 'skate'],\n  shoot:   ['#F9E4E2', '#A31F18', 'shoot'],\n  iq:      ['#EFE7F6', '#5C3780', 'iq'],\n  trans:   ['#FBE9DA', '#A9551A', 'trans'],\n  def:     ['#EBEDF0', '#4C545F', 'def'],\n  special: ['#E1EFF2', '#175E6C', 'special'],\n  compete: ['#E8E2D6', '#3A3630', 'compete']\n};\nconst ROLE_ICONS = {\n  'Head coach': 'M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2M9 12h6M9 16h4',\n  'Assistant coach': 'M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2M12 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8',\n  'Goaltender coach': 'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z',\n  'Manager': 'M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z'\n};\nconst TAG_COLORS = { _default: CAT.compete };\n[['pass', ['Passing/Receiving','Passing','Receiving','Puck Support','Breakouts']],\n ['comm', ['Communication','Teamwork']],\n ['skate', ['Skating','Agility','Conditioning','Balance']],\n ['shoot', ['Shooting','Scoring','Rebounds','Net Drive','Offensive']],\n ['iq', ['Awareness','Timing','Decisions','Attention','Intelligence','Reading','Reacting','Read & React','Creativity','Positional Play','Positioning','SAG']],\n ['trans', ['Transition','Zone Entry','Line Changes','Puck Control','Puck Protection']],\n ['def', ['Defensive','Stick Positioning','Positions']],\n ['special', ['Power Play']],\n ['compete', ['Compete','Battle','Hustle','Warrior Spirit']]\n].forEach(([k, list]) => list.forEach(t => { TAG_COLORS[t] = CAT[k]; }));\n\nclass Component extends DCLogic {\n  state = { f: {}, saved: false };\n\n  componentDidMount() {\n    try {\n      const raw = localStorage.getItem(KEY);\n      if (raw) this.setState({ f: JSON.parse(raw) || {} });\n    } catch (e) {}\n  }\n\n  save(next) {\n    try { localStorage.setItem(KEY, JSON.stringify(next)); } catch (e) {}\n  }\n\n  renderVals() {\n    const f = this.state.f || {};\n    const set = {};\n    FIELDS.forEach(k => {\n      set[k] = e => {\n        const next = Object.assign({}, this.state.f, { [k]: e.target.value });\n        this.save(next);\n        this.setState({ f: next, saved: true });\n      };\n    });\n\n    const staff = [\n      { role: 'Head coach', name: 'Steve Parsons', email: 'steveparsons@edgebosshockey.com', phone: '403.200.4726' },\n      { role: 'Assistant coach', name: 'Jared Collister', email: 'jaredc@cmbinsurance.ca', phone: '403.808.1922' },\n      { role: 'Assistant coach', name: 'Adam Redmond', email: 'adamredmond78@gmail.com', phone: '403.613.6711' },\n      { role: 'Assistant coach', name: 'Peter Tsoulamanis', email: 'tsoulamanis@hotmail.com', phone: '403.863.5811' },\n      { role: 'Goaltender coach', name: 'Derek Purfield', email: 'purfield@hotmail.com', phone: '403.903.6685' },\n      { role: 'Manager', name: 'Sonja Silenzi', email: 'salbuvik@gmail.com', phone: '403.828.0613' }\n    ].map(s => Object.assign({}, s, {\n      mailto: 'mailto:' + s.email,\n      tel: 'tel:+1' + s.phone.replace(/\\./g, ''),\n      icon: ROLE_ICONS[s.role] || ROLE_ICONS.Manager\n    }));\n\n    const drills = [\n      ['Old Faithful', ['Passing/Receiving','Agility','Communication','Transition','Net Drive','Shooting','Rebounds','Puck Support']],\n      ['Wakey Wakey', ['Passing/Receiving','Awareness','Communication','Timing','Skating','Puck Support','Net Drive','Shooting','Scoring']],\n      ['Middle Lane Drive', ['Passing','Skating','Zone Entry','Net Drive','Timing','Scoring','Puck Support']],\n      ['Around the World', ['Passing','Shooting','Timing','Power Play']],\n      ['Bruins Backcheck', ['Skating','Conditioning','Hustle','Decisions','Attention']],\n      ['Royals Passing', ['Passing/Receiving','Communication']],\n      ['Shuttle Passing', ['Passing/Receiving','Communication']],\n      ['Borat', ['Passing/Receiving','Positional Play','Defensive','Offensive','Zone Entry','Puck Support']],\n      ['Over & Off', ['Breakouts','Intelligence','Line Changes']],\n      ['5 Shift Scrimmage', ['Teamwork','Communication','Read & React']],\n      ['Jungle Races', ['Compete']],\n      ['Double Cross & Drop', ['Skating','Timing','Passing','Zone Entry','Creativity']],\n      ['Avalanche Angling', ['Skating','Stick Positioning','Puck Protection','Net Drive','Battle']],\n      ['NZ Chaos', ['Puck Control','SAG']],\n      ['10 Puck Shootout', ['Scoring','Communication']],\n      ['Rodeo', ['Compete','Balance','Warrior Spirit']],\n      ['Bloody Nose Alley', ['Transition','Passing','Defensive','Offensive','Battle']],\n      ['Power Play Game', ['Passing/Receiving','Reading','Reacting','Offensive','Defensive']],\n      ['Canada Cup', ['Passing','Timing','Receiving','Positions','Shooting']],\n      ['Tippy Tap', ['Passing','Communication','Creativity']],\n      ['123', ['Passing','Communication','Creativity']],\n      ['Zone Walkthroughs', ['Positioning','Communication','Puck Support','Hustle']],\n      ['Faceoff Plays', ['Positioning','Communication','Puck Support','Hustle']]\n    ].map((d, i) => ({ n: i + 1, name: d[0], tags: d[1].map(t => {\n      const c = TAG_COLORS[t] || TAG_COLORS._default;\n      return { label: t, bg: c[0], fg: c[1], icon: ICONS[c[2]] };\n    }) }));\n\n    const cats = Object.keys(CAT_LABELS).map(k => ({\n      key: k, label: CAT_LABELS[k], solid: CAT_SOLID[k], icon: ICONS[k]\n    }));\n\n    return {\n      f, set, staff, drills, cats,\n      savedNote: this.state.saved ? 'Saved on this device.' : '',\n      printForm: () => window.print(),\n      clearForm: () => {\n        try { localStorage.removeItem(KEY); } catch (e) {}\n        this.setState({ f: {}, saved: false });\n      }\n    };\n  }\n}\n\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
</html>